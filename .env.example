# ==============================================================================
# Lezgi Learn — Environment Variables
# Copy this file to .env.local and fill in values from your Supabase dashboard:
# https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# Public variables (safe to expose to browser, protected by Postgres RLS)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only secret (NEVER expose with NEXT_PUBLIC_ prefix!)
# Used ONLY by scripts/seed-content.ts and trusted server admin operations.
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"
